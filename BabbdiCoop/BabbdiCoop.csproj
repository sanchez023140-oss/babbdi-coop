<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>BabbdiCoop</AssemblyName>
    <Version>0.5.1</Version>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>BabbdiCoop</RootNamespace>
    <!-- BepInEx plugins are loaded by game's Mono runtime; keep copy local off and copy manually in build.ps1 -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Game folder, referenced from here on machine -->
    <GameDir>E:\858\BABBDI_WINDOWS_1.2.3</GameDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
